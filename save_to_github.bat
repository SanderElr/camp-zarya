@echo off
chcp 65001 >nul
title Сохранение игры Лагерь «Заря» на GitHub

echo ========================================================
echo   СОХРАНЕНИЕ И СИНХРОНИЗАЦИЯ С GITHUB (camp-zarya)
echo ========================================================
echo.

cd /d "%~dp0"

echo [1/3] Проверка и сборка файлов...
git add .

set /p commit_msg="Введите описание изменений (или Enter для авто-сохранения): "
if "%commit_msg%"=="" set commit_msg=Обновление: %date% %time%

echo.
echo [2/3] Локальное сохранение: "%commit_msg%"...
git commit -m "%commit_msg%" 2>nul
if %ERRORLEVEL% NEQ 0 (
    echo (Новых изменений для коммита не обнаружено, проверяем отправку...)
)

echo.
echo [3/3] Отправка на GitHub...
git push -u origin main

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ========================================================
    echo   [УСПЕХ] Игра сохранена на ПК и обновлена на GitHub!
    echo ========================================================
) else (
    echo.
    echo ========================================================
    echo   [ВНИМАНИЕ] Если это первый запуск, браузер мог запросить
    echo   авторизацию GitHub. Завершите вход и попробуйте снова.
    echo ========================================================
)

echo.
pause
